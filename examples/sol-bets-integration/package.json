{
  "name": "sol-bets-integration-example",
  "version": "0.1.0",
  "private": true,
  "description": "Complete example showing payment channel integration with x402 fallback for Sol-Bets",
  "scripts": {
    "build": "tsc",
    "server": "ts-node src/server/main.ts",
    "client": "ts-node src/client/main.ts",
    "demo": "ts-node src/demo.ts",
    "dev:server": "ts-node-dev src/server/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana-payment-channel/core": "workspace:*",
    "@solana-payment-channel/server": "workspace:*",
    "@solana-payment-channel/client": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@solana/web3.js": "^1.95.8",
    "express": "^4.21.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.24",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}