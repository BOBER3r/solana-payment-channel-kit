{
  "name": "@x402-channels/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Payment channels implementation for x402 protocol on Solana - enabling efficient micropayments with on-chain settlement",
  "keywords": [
    "solana",
    "x402",
    "payment-channels",
    "micropayments",
    "escrow",
    "usdc",
    "blockchain"
  ],
  "author": "x402 contributors",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "programs/*/tests",
    "examples/*"
  ],
  "scripts": {
    "install:deps": "pnpm install",
    "build": "turbo run build",
    "build:programs": "cd programs/payment-channel && anchor build",
    "build:all": "pnpm run build:programs && pnpm run build",
    "test": "turbo run test",
    "test:programs": "cd programs/payment-channel && anchor test",
    "test:all": "pnpm run test:programs && pnpm run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "deploy:devnet": "cd programs/payment-channel && anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "cd programs/payment-channel && anchor deploy --provider.cluster mainnet",
    "generate-idl": "cd programs/payment-channel && anchor idl init --filepath target/idl/payment_channel.json"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.19.24",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "chai": "^4.3.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@x402-solana/core": "0.3.2"
  }
}
